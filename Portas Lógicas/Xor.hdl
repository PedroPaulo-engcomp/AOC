// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Nand(a=a, b=a, out=fio1);
    Nand(a=b, b=b, out=fio2);
    Nand(a=fio1, b=b, out=fio3);
    Nand(a=a, b=fio2, out=fio4);
    Nand(a=fio1, b=fio2, out=out);
}
